+def _load_saved_fold_metrics(args, fold):
+    """Parse a per-fold metrics file written by compute_all_metrics, or return None."""
+    path = f"results/metrics_{get_model_file_suffix(args, fold)}.txt"
+    if not os.path.exists(path):
+        return None
+    txt = open(path).read()
+    loss = re.search(r"Loss: ([0-9.]+)", txt)
+    rows = re.findall(r"Acc: ([0-9.]+), AUC: ([0-9.]+), Prec: ([0-9.]+), Rec: ([0-9.]+), F1: ([0-9.]+)", txt)
+    if not loss or not rows:
+        return None
+    metrics = [float(loss.group(1))]
+    for row in rows:
+        metrics.extend(float(x) for x in row)
+    return metrics
+
